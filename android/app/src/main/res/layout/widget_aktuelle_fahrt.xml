<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/karte"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@drawable/widget_karte_hintergrund"
        android:padding="14dp">

        <TextView
            android:id="@+id/item_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/widget_gelb"
            android:textStyle="bold"
            android:textAllCaps="true"
            android:textSize="11sp"
            android:letterSpacing="0.04" />

        <TextView
            android:id="@+id/item_ort"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/widget_text"
            android:textStyle="bold"
            android:textSize="17sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/item_zeiten"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/widget_akzent"
            android:textStyle="bold"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/item_folge"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="8dp"
            android:gravity="bottom"
            android:textColor="@color/widget_text_soft"
            android:textSize="12sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/nav_zurueck"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:padding="6dp"
                android:text="‹ Zurück"
                android:textColor="@color/widget_text_soft"
                android:textStyle="bold"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/nav_position"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:textColor="@color/widget_text_faint"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/nav_weiter"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:padding="6dp"
                android:gravity="end"
                android:text="Weiter ›"
                android:textColor="@color/widget_text_soft"
                android:textStyle="bold"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/leer_text"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_karte_hintergrund"
        android:gravity="center"
        android:padding="16dp"
        android:text="Kein Dienst für heute gespeichert"
        android:textColor="@color/widget_text_faint"
        android:textSize="13sp"
        android:visibility="gone" />
</FrameLayout>
